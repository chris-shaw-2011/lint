{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"rootDir": "src",
		"outDir": "dist",
		"noEmit": false,
		"rewriteRelativeImportExtensions": true
	},
	"include": [
		"src/**/*.ts"
	]
}
