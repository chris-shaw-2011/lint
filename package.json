{
	"name": "@chris-shaw-2011/lint",
	"version": "1.4.1",
	"description": "Shared lint configuration and tooling for TypeScript, React, and SCSS workspaces.",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./without-type-inference": {
			"types": "./dist/without-type-inference.d.ts",
			"default": "./dist/without-type-inference.js"
		},
		"./react": {
			"types": "./dist/react.d.ts",
			"default": "./dist/react.js"
		},
		"./knip": {
			"types": "./dist/knip.d.ts",
			"default": "./dist/knip.js"
		},
		"./stylelint": {
			"types": "./dist/stylelint.d.ts",
			"default": "./dist/stylelint.js"
		}
	},
	"bin": {
		"buf": "./dist/bin/buf.js",
		"eslint": "./dist/bin/eslint.js",
		"knip": "./dist/bin/knip.js",
		"proto-style": "./dist/bin/proto-style.js",
		"scss-modules-unused": "./dist/bin/scss-modules-unused.js",
		"sherif": "./dist/bin/sherif.js",
		"stylelint": "./dist/bin/stylelint.js"
	},
	"files": [
		"dist",
		"buf.policy.yaml",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=24.0.0",
		"npm": ">=11.0.0"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com",
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/chris-shaw-2011/lint.git"
	},
	"bugs": {
		"url": "https://github.com/chris-shaw-2011/lint/issues"
	},
	"homepage": "https://github.com/chris-shaw-2011/lint#readme",
	"scripts": {
		"build": "tsc -p tsconfig.build.json && node --experimental-strip-types ./scripts/mark-bin-executable.ts",
		"clean": "rimraf dist",
		"prepack": "npm run clean && npm run build",
		"test": "node --experimental-strip-types --test ./scripts/*.test.ts",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"lint": "node ./node_modules/eslint/bin/eslint.js .",
		"lint:fix": "node ./node_modules/eslint/bin/eslint.js . --fix",
		"knip": "node ./node_modules/knip/bin/knip.js --config knip.config.ts --reporter compact",
		"knip:json": "node ./node_modules/knip/bin/knip.js --config knip.config.ts --reporter json",
		"publint": "publint --pack false",
		"attw": "npm_config_cache=/tmp/npm-cache-chris-shaw-lint attw --pack --profile esm-only .",
		"check": "npm run lint && npm run test && npm run typecheck && npm run knip && npm run publint && npm run attw",
		"test:smoke": "node --experimental-strip-types ./scripts/smoke-test.ts",
		"verify": "npm run build && npm run check && npm run test:smoke"
	},
	"dependencies": {
		"@bufbuild/buf": "^1.73.0",
		"@eslint-react/eslint-plugin": "^5.23.1",
		"@eslint/js": "^10.0.1",
		"@eslint/markdown": "^8.0.3",
		"@stylistic/eslint-plugin": "^5.7.1",
		"@stylistic/stylelint-config": "^5.0.0",
		"eslint": "^10.10.0",
		"eslint-plugin-jsonc": "^3.4.2",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.6",
		"eslint-plugin-type-inference": "0.1.0",
		"eslint-plugin-yml": "^3.8.0",
		"globals": "^17.12.0",
		"jsonc-eslint-parser": "^3.3.0",
		"knip": "^6.35.1",
		"sherif": "^1.13.0",
		"stylelint": "^17.15.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"stylelint-scss": "^7.2.0",
		"ts-api-utils": "^2.5.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@types/node": "^26.5.1",
		"publint": "^0.3.24",
		"rimraf": "^6.0.1"
	},
	"packageManager": "npm@11.6.2",
	"allowScripts": {
		"@bufbuild/buf@1.73.0": true
	},
	"bundleDependencies": [
		"@eslint-react/eslint-plugin",
		"ts-api-utils",
		"typescript"
	]
}
